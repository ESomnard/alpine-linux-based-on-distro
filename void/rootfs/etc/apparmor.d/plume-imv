# Plume — imv (images) confiné, sans Internet.
# Pas d'accès à tes secrets ni aux cookies de Firefox, pas de démarrage automatique,
# pas d'exécution de fichiers téléchargés. Ajustements perso : /etc/apparmor.d/local/plume-imv
abi <abi/4.0>,
include <tunables/global>

profile plume-imv /usr/bin/imv{,-wayland,-x11,-dir} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/plume-perso>

  file,
  network unix,
  deny network inet,
  deny network inet6,
  unix,
  dbus,
  signal (send, receive) peer=plume-imv,
  signal (receive),
  deny @{HOME}/{.mozilla,.config/mozilla}/** mrwklx,
  # un lien ouvert depuis l'appli : Firefox garde son propre profil
  /usr/lib/firefox/firefox Px -> plume-firefox,

  include if exists <local/plume-imv>
}
