# Plume — mpv (vidéo) confiné : il garde Internet (vidéos en ligne).
# Pas d'accès à tes secrets ni aux cookies de Firefox, pas de démarrage automatique,
# pas d'exécution de fichiers téléchargés. Ajustements perso : /etc/apparmor.d/local/plume-mpv
abi <abi/4.0>,
include <tunables/global>

profile plume-mpv /usr/bin/{mpv,umpv} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/plume-perso>

  file,
  network,
  unix,
  dbus,
  signal (send, receive) peer=plume-mpv,
  signal (receive),
  deny @{HOME}/{.mozilla,.config/mozilla}/** mrwklx,
  # un lien ouvert depuis l'appli : Firefox garde son propre profil
  /usr/lib/firefox/firefox Px -> plume-firefox,

  include if exists <local/plume-mpv>
}
