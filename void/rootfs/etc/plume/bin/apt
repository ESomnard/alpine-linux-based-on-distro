#!/bin/sh
# Plume (Void) — « apt » pour les habitués d'Ubuntu/Debian.
# Plume Void utilise xbps, le gestionnaire de paquets de Void Linux : cette
# commande traduit apt, apt-get et apt-cache vers xbps, y compris les noms de
# paquets Debian les plus courants (build-essential, python3-pip, libssl-dev…).

prog=$(basename "$0")

err() { printf 'E: %s\n' "$*" >&2; }
note() { printf '%s\n' "$*" >&2; }

usage() {
	cat <<EOF2
$prog (Plume) — traduit les commandes apt vers xbps, le gestionnaire de Void.

  sudo $prog update                 mettre à jour la liste des paquets
  sudo $prog upgrade                mettre à jour le système
  sudo $prog install PAQUET…        installer
  sudo $prog remove PAQUET…         désinstaller (aussi : purge)
  sudo $prog reinstall PAQUET…      réinstaller / réparer
       $prog search MOT             chercher un paquet
       $prog show PAQUET            décrire un paquet
       $prog list --installed       paquets installés (aussi : --upgradable)
       $prog policy PAQUET          version installée et disponible

Les noms Debian courants sont traduits (build-essential → base-devel,
libssl-dev → openssl-devel…). Les fichiers .deb ne s'installent pas sur Plume :
cherche le paquet avec « $prog search », sinon passe par Flatpak.
EOF2
}

need_root() {
	if [ "$(id -u)" -ne 0 ]; then
		err "il faut les droits administrateur. Essaie : sudo $prog $ORIG_ARGS"
		exit 100
	fi
}

exists() { xbps-query -R --property=pkgver "$1" >/dev/null 2>&1; }

# nom Debian -> nom Void
translate() {
	case "$1" in
	build-essential) echo base-devel ;;
	software-properties-common|apt-transport-https|ca-certificates-java) echo "" ;;
	python3-venv|python3-distutils|python-is-python3) echo python3 ;;
	python3-tk) echo python3-tkinter ;;
	openssh-server|openssh-client) echo openssh ;;
	dnsutils) echo bind-utils ;;
	iputils-ping) echo iputils ;;
	netcat|netcat-openbsd|netcat-traditional) echo openbsd-netcat ;;
	default-jdk|openjdk-*-jdk) echo openjdk21 ;;
	default-jre|openjdk-*-jre) echo openjdk21-jre ;;
	docker.io) echo docker ;;
	docker-compose-plugin) echo docker-compose ;;
	ninja-build) echo ninja ;;
	fd-find) echo fd ;;
	p7zip-full|p7zip) echo 7zip ;;
	xz-utils) echo xz ;;
	libssl-dev) echo openssl-devel ;;
	zlib1g-dev) echo zlib-devel ;;
	libsqlite3-dev) echo sqlite-devel ;;
	libcurl4-openssl-dev|libcurl4-gnutls-dev) echo libcurl-devel ;;
	libncurses-dev|libncurses5-dev|libncursesw5-dev) echo ncurses-devel ;;
	libreadline-dev) echo readline-devel ;;
	libbz2-dev) echo bzip2-devel ;;
	liblzma-dev) echo liblzma-devel ;;
	libgtk-3-dev) echo gtk+3-devel ;;
	libsdl2-dev) echo SDL2-devel ;;
	*) echo "$1" ;;
	esac
}

# nom Debian -> paquet Void existant (vide si inutile, échec si introuvable)
resolve() {
	t=$(translate "$1")
	[ -z "$t" ] && return 0
	if exists "$t"; then echo "$t"; return 0; fi
	case "$1" in
	lib*-dev) c="${1%-dev}-devel"; exists "$c" && { echo "$c"; return 0; }
		c="${c#lib}"; exists "$c" && { echo "$c"; return 0; } ;;
	*-dev) c="${1%-dev}-devel"; exists "$c" && { echo "$c"; return 0; } ;;
	esac
	return 1
}

ORIG_ARGS="$*"
YES=""
for a do
	shift
	case "$a" in
	-y | --yes | --assume-yes) YES=-y; continue ;;
	-q | -qq | --quiet | --no-install-recommends | --install-recommends | \
	-f | --fix-broken | --allow-unauthenticated) continue ;;
	esac
	set -- "$@" "$a"
done

cmd=${1:-help}
[ $# -gt 0 ] && shift

if [ "$prog" = apt-cache ]; then
	case "$cmd" in search|show|policy|depends|rdepends|showpkg) ;; *) usage; exit 100 ;; esac
fi

case "$cmd" in
update)
	need_root
	exec xbps-install -S
	;;
upgrade|full-upgrade|dist-upgrade)
	need_root
	xbps-install -S >/dev/null 2>&1 || true
	# xbps se met à jour lui-même d'abord s'il le faut
	xbps-install -un 2>/dev/null | grep -q '^xbps-[0-9]' && xbps-install -u $YES xbps
	exec xbps-install -u $YES
	;;
install)
	need_root
	[ $# -gt 0 ] || { err "indique au moins un paquet : sudo $prog install NOM"; exit 100; }
	# liste des paquets à jour d'abord (sinon : version disparue des serveurs, téléchargement en échec),
	# et xbps lui-même s'il le faut (il refuse d'installer quoi que ce soit tant qu'il est trop vieux)
	note "• liste des paquets mise à jour…"
	xbps-install -S >/dev/null 2>&1 || true
	xbps-install -un 2>/dev/null | grep -q '^xbps-[0-9]' && xbps-install -uy xbps >/dev/null 2>&1
	pkgs=""
	for p in "$@"; do
		case "$p" in
		*.deb)
			err "« $p » est un paquet Debian : il ne s'installe pas sur Plume (Void)."
			note "   Cherche l'équivalent : $prog search NOM, ou une version Flatpak."
			exit 100 ;;
		esac
		if r=$(resolve "$p"); then
			if [ -z "$r" ]; then
				note "• $p : inutile sur Plume, ignoré"
			else
				[ "$r" != "$p" ] && note "• $p → $r (nom Void)"
				pkgs="$pkgs $r"
			fi
		else
			err "paquet introuvable : $p"
			note "   Essaie : $prog search $p"
			exit 100
		fi
	done
	[ -n "$pkgs" ] || exit 0
	exec xbps-install $YES $pkgs
	;;
reinstall)
	need_root
	exec xbps-install -f $YES "$@"
	;;
remove|purge|autopurge)
	need_root
	[ $# -gt 0 ] || { err "indique au moins un paquet"; exit 100; }
	pkgs=""
	for p in "$@"; do
		r=$(translate "$p")
		[ -n "$r" ] && pkgs="$pkgs $r"
	done
	exec xbps-remove -R $YES $pkgs
	;;
autoremove)
	need_root
	exec xbps-remove -o $YES
	;;
autoclean|clean)
	need_root
	exec xbps-remove -O $YES
	;;
search)
	[ $# -gt 0 ] || { err "indique un mot à chercher"; exit 100; }
	# « [-] nom-1.0_1   description » ; ordre : nom exact, début du nom, nom, description
	xbps-query -Rs "" 2>/dev/null | awk -v q="$*" '
	BEGIN { nq = split(tolower(q), w, " ") }
	{
		inst = substr($0, 2, 1) == "*" ? " [installé]" : ""
		nv = $2; desc = $0; sub(/^\[.\] [^ ]+ +/, "", desc)
		n = nv; v = ""
		if (match(nv, /-[^-]+$/)) { n = substr(nv, 1, RSTART - 1); v = substr(nv, RSTART + 1) }
		ln = tolower(n); ld = tolower(desc)
		for (k = 1; k <= nq; k++) if (!index(ln, w[k]) && !index(ld, w[k])) next
		r = ln == w[1] ? 0 : index(ln, w[1]) == 1 ? 1 : index(ln, w[1]) ? 2 : 3
		printf "%d\t%s\t%s%s\t%s\n", r, n, v, inst, desc
	}' | sort -t "$(printf '\t')" -k1,1n -k2,2 | awk -F '\t' '{ printf "%s (%s)\n    %s\n", $2, $3, $4 }'
	;;
show|showpkg)
	[ $# -gt 0 ] || { err "indique un paquet"; exit 100; }
	for p in "$@"; do
		r=$(resolve "$p") || { err "paquet introuvable : $p"; continue; }
		[ -n "$r" ] || continue
		inst=non
		xbps-query "$r" >/dev/null 2>&1 && inst=oui
		xbps-query -R "$r" 2>/dev/null | awk -v n="$r" -v inst="$inst" '
		BEGIN { printf "Paquet : %s\nInstallé : %s\n", n, inst }
		/^pkgver:/ { v = $2; sub(/^.*-/, "", v); print "Version : " v }
		/^short_desc:/ { sub(/^short_desc: /, ""); print "Description : " $0 }
		/^homepage:/ { print "Site : " $2 }
		/^installed_size:/ { print "Taille : " $2 }
		/^license:/ { sub(/^license: /, ""); print "Licence : " $0 }'
		echo
	done
	;;
depends)
	exec xbps-query -Rx "$@"
	;;
rdepends)
	exec xbps-query -RX "$@"
	;;
policy)
	for p in "$@"; do
		printf '%s:\n  Installé : %s\n  Candidat : %s\n' "$p" \
			"$(xbps-query -p pkgver "$p" 2>/dev/null | sed 's/.*-//' || true)" \
			"$(xbps-query -R -p pkgver "$p" 2>/dev/null | sed 's/.*-//')"
	done
	;;
list)
	case "${1:-}" in
	--installed) xbps-query -l 2>/dev/null | awk '{print $2}' ;;
	--upgradable|--upgradeable) xbps-install -un 2>/dev/null | awk '$2 == "update" {print $1}' ;;
	"") xbps-query -Rs "" 2>/dev/null | awk '{print $2}' ;;
	*) xbps-query -Rs "$1" 2>/dev/null | awk '{print $2}' ;;
	esac
	;;
help|-h|--help)
	usage
	;;
edit-sources)
	need_root
	exec ${EDITOR:-vi} /etc/xbps.d/10-plume.conf
	;;
*)
	err "commande inconnue : $cmd"
	usage
	exit 100
	;;
esac
