#!/bin/sh
# Plume (Void, glibc) — mises à jour de tout le système (paquets Void + applis Flathub).
#   plume-maj                 liste les mises à jour, demande, puis met tout à jour
#   plume-maj -y              sans question
#   plume-maj --liste         liste seulement
#   plume-maj --bios          firmwares du PC (BIOS/UEFI, SSD, Thunderbolt…) via fwupd
#   plume-maj --verifier      (root) relit les dépôts et compte les mises à jour
#                             dans /var/lib/plume/maj-dispo — lancé tout seul par
#                             la barre, toutes les 6 h, sans mot de passe (sudoers)
# Void est « en continu » (rolling) : pas de changement de version à faire, tout
# arrive par les mises à jour normales.
set -u

ETAT=/var/lib/plume/maj-dispo

# « nom-2.0_1 update x86_64 dépôt … » (après xbps-install -S)
lister() { xbps-install -un 2>/dev/null | awk '$2 == "update" {print $1}'; }
compter() { lister | grep -c . ; }

if [ "${1:-}" = --verifier ]; then
	[ "$(id -u)" -eq 0 ] || { echo "plume-maj --verifier : à lancer en root (sudo)" >&2; exit 1; }
	mkdir -p /var/lib/plume
	# un dépôt injoignable n'empêche pas de compter avec les autres
	xbps-install -S >/dev/null 2>&1 || true
	n=$(compter)
	printf '%s\n' "${n:-0}" > "$ETAT.tmp" && chmod 644 "$ETAT.tmp" && mv "$ETAT.tmp" "$ETAT"
	rm -f /var/lib/plume/version-dispo
	exit 0
fi

if [ -t 1 ]; then
	B=$(printf '\033[1;36m') V=$(printf '\033[1;32m') R=$(printf '\033[1;31m') J=$(printf '\033[1;33m') N=$(printf '\033[0m')
else
	B="" V="" R="" J="" N=""
fi
titre() { printf '\n%s◆ %s%s\n' "$B" "$*" "$N"; }

SUDO=""
[ "$(id -u)" -eq 0 ] || SUDO=sudo

fin() {
	if [ "${PLUME_MAJ_FENETRE:-}" = 1 ]; then
		printf '\nEntrée pour fermer… '
		read -r _ || true
	fi
	exit "$1"
}

if [ "${1:-}" = --nouvelle-version ]; then
	echo "Void Linux est « en continu » : il n'y a pas de nouvelle version à installer,"
	echo "tout arrive avec les mises à jour normales (plume-maj)."
	fin 0
fi

if [ "${1:-}" = --bios ]; then
	titre "Firmwares du PC (BIOS/UEFI, SSD, dock, Thunderbolt…)"
	command -v fwupdmgr >/dev/null || { echo "fwupd absent : sudo xbps-install -S fwupd fwupd-efi"; fin 1; }
	echo "Lecture du catalogue des fabricants (LVFS)…"
	$SUDO fwupdmgr refresh --force >/dev/null 2>&1 || true
	$SUDO fwupdmgr get-updates 2>/dev/null
	case $? in
	0) ;;
	2) printf '%s✔ Aucun firmware à mettre à jour (ou matériel non pris en charge par son fabricant).%s\n' "$V" "$N"; fin 0 ;;
	*) printf '%sImpossible de lire les firmwares (connexion internet ?).%s\n' "$J" "$N"; fin 1 ;;
	esac
	printf '\n%sBranche le chargeur et ne coupe pas le courant pendant la mise à jour.%s\n' "$J" "$N"
	printf 'Installer maintenant ? [o/N] '
	read -r rep || rep=n
	case "$rep" in [oOyY]*) ;; *) echo "Rien n'a été changé."; fin 0 ;; esac
	if $SUDO fwupdmgr update --assume-yes --no-reboot-check; then
		printf '%s✔ Firmwares prêts : redémarre le PC pour terminer (l'"'"'écran du fabricant peut s'"'"'afficher).%s\n' "$V" "$N"
		fin 0
	fi
	fin 1
fi

titre "Mises à jour de Plume"
echo "Lecture des dépôts Void…"
if ! $SUDO xbps-install -S >/dev/null 2>&1; then
	printf '%sUn ou plusieurs dépôts sont injoignables (connexion internet ?) : on continue avec les autres.%s\n' "$J" "$N"
fi

LISTE=$(lister)
NB=$(printf '%s' "$LISTE" | grep -c .)
FLAT=""
if command -v flatpak >/dev/null 2>&1 && [ "$(id -u)" -ne 0 ]; then
	FLAT=$(flatpak remote-ls --updates --user --columns=application 2>/dev/null)
fi
NBF=$(printf '%s' "$FLAT" | grep -c .)

if [ "$NB" -eq 0 ] && [ "$NBF" -eq 0 ]; then
	printf '%s✔ Tout est à jour.%s\n' "$V" "$N"
	$SUDO -n /usr/bin/plume-maj --verifier 2>/dev/null || true
	fin 0
fi

if [ "$NB" -gt 0 ]; then
	titre "$NB paquet(s) Void"
	printf '%s\n' "$LISTE" | while read -r nv; do
		n=${nv%-*}
		old=$(xbps-query -p pkgver "$n" 2>/dev/null)
		printf '  %s  %s → %s\n' "$n" "${old##*-}" "${nv##*-}"
	done
fi
if [ "$NBF" -gt 0 ]; then
	titre "$NBF appli(s) Flathub"
	printf '%s\n' "$FLAT" | sed 's/^/  /'
fi
[ "${1:-}" = --liste ] && fin 0

if [ "${1:-}" != -y ]; then
	printf '\nMettre à jour maintenant ? [O/n] '
	read -r rep || rep=n
	case "$rep" in [nN]*) echo "Rien n'a été changé."; fin 0 ;; esac
fi

OK=1
if [ "$NB" -gt 0 ]; then
	titre "Mise à jour des paquets Void"
	# instantané du système avant de toucher à quoi que ce soit (retour possible : plume-retour)
	if [ "$(findmnt -no FSTYPE / 2>/dev/null)" = btrfs ] && command -v plume-retour >/dev/null; then
		$SUDO plume-retour --auto "avant la mise à jour de $NB paquet(s)" || true
	fi
	# xbps se met d'abord à jour lui-même s'il le faut (sinon il refuse le reste)
	if printf '%s\n' "$LISTE" | grep -q '^xbps-[0-9]'; then
		$SUDO xbps-install -uy xbps || OK=0
	fi
	$SUDO xbps-install -uy || OK=0
fi
if [ "$NBF" -gt 0 ]; then
	titre "Mise à jour des applis Flathub"
	flatpak update --user -y --noninteractive || OK=0
fi
$SUDO -n /usr/bin/plume-maj --verifier 2>/dev/null || $SUDO /usr/bin/plume-maj --verifier || true

if [ "$OK" = 1 ]; then
	printf '\n%s✔ Mises à jour terminées.%s\n' "$V" "$N"
	[ "$(findmnt -no FSTYPE / 2>/dev/null)" = btrfs ] && printf 'En cas de souci : sudo plume-retour (revenir à l'"'"'état d'"'"'avant).\n'
else
	printf '\n%s✖ Une partie des mises à jour a échoué (voir ci-dessus).%s\n' "$R" "$N"
fi
# nouveau noyau installé (le plus récent de /lib/modules n'est pas celui en cours)
DERNIER=$(ls /lib/modules 2>/dev/null | sort -V | tail -1)
if [ -n "$DERNIER" ] && [ "$DERNIER" != "$(uname -r)" ]; then
	printf '%s⟳ Nouveau noyau installé : redémarre pour l'"'"'utiliser.%s\n' "$J" "$N"
	command -v notify-send >/dev/null && notify-send -a Plume "Mises à jour" "Nouveau noyau : redémarre pour l'utiliser." 2>/dev/null
fi
command -v fwupdmgr >/dev/null && printf 'Firmwares du PC (BIOS, SSD…) : plume-maj --bios\n'
[ "$OK" = 1 ] && fin 0 || fin 1
