# Plume Linux (Void, glibc) — paquets du système live ET installé.
# Mêmes rôles que la version Alpine (rootfs/etc/plume/packages/*.list).
# --- Socle ---
sudo opendoas dbus seatd iwd openresolv dhcpcd chrony wget curl net-tools
zramen              # swap compressé en RAM
brightnessctl
cryptsetup grub grub-x86_64-efi efibootmgr dosfstools e2fsprogs gptfdisk   # installateur (LUKS2, BIOS + UEFI)
# --- Bureau Wayland ---
sway swaybg swayidle swaylock
greetd cage         # écran de connexion : greetd lance plume-hud dans cage
foot libvterm fuzzel librsvg gdk-pixbuf
mako libnotify
nftables            # pare-feu (plume-parefeu)
apparmor            # confinement des programmes
grim slurp wl-clipboard
mesa-dri mesa-vaapi intel-media-driver
dejavu-fonts-ttf wqy-microhei fastfetch
ibus ibus-libpinyin # chinois pinyin
pipewire wireplumber alsa-pipewire
bluez
xdg-utils papirus-icon-theme
# clés USB et disques externes : montage sans mot de passe (polkit, groupe storage), automatique (udiskie)
udisks2 polkit gvfs udiskie
# portails Wayland : partage d'écran (wlr), fenêtres « Ouvrir un fichier » (gtk)
xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk
# réglage des écrans (plume-ecrans) ; état de Secure Boot (installateur)
wdisplays jq mokutil
# imprimantes (sans pilote : IPP Everywhere) et scanners du réseau ou USB
cups cups-filters avahi nss-mdns system-config-printer sane sane-airscan simple-scan
# batterie (modes économie / performance), firmwares du PC (BIOS, SSD…)
power-profiles-daemon upower fwupd fwupd-efi
# VPN : WireGuard, OpenVPN, entreprise (AnyConnect, GlobalProtect, Fortinet…)
wireguard-tools openvpn openconnect vpnc-scripts
# lumière du soir, installateur graphique
wlsunset yad
# sauvegarde ; accessibilité (lecteur d'écran Orca en français, clavier à l'écran)
rsync orca speech-dispatcher espeak-ng at-spi2-core wvkbd
# --- Applications du quotidien ---
firefox firefox-i18n-fr mpv imv zathura zathura-pdf-mupdf pcmanfm micro
# --- Plume (dépôt .xbps Plume) ---
plume-bureau
