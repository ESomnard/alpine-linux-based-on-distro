# Plume — configuration sway minimale. Doc : man 5 sway
set $mod Mod4
# terminal HUD (plume-term), foot en secours
set $term plume-terminal
# fuzzel voit aussi les applis Flatpak installées par la Logithèque
set $menu env XDG_DATA_DIRS=$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share fuzzel
# Écran de verrouillage HUD (plume-hud) ; swaylock en secours
set $lock plume-hud -f || swaylock -f -c 1e1e2e

# --- Entrées ---
# AZERTY (fr) + QWERTY (us) : Alt+Maj pour basculer
input type:keyboard {
    xkb_layout fr,us
    xkb_options grp:alt_shift_toggle
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# --- Apparence : palette du HUD Plume ---
# fond d'écran HUD (généré par plume-wall), couleur unie en secours
output * bg #02060b solid_color
output * bg /usr/share/plume/wallpaper.png fill
font pango:JetBrains Mono 10
default_border pixel 2
default_floating_border pixel 2
titlebar_padding 10 4
gaps inner 10
gaps outer 6
# classe                 bordure  fond     texte    indicateur bordure-enfant
client.focused           #4fb8e0  #03080e  #e9f9ff  #9fe4ff    #4fb8e0
client.focused_inactive  #1d5a78  #03080e  #5f8ea5  #1d5a78    #1d5a78
client.unfocused         #0b2433  #02060b  #5f8ea5  #0b2433    #0b2433
client.urgent            #ff5470  #03080e  #ff5470  #ff5470    #ff5470
client.background        #02060b

# --- Démarrage ---
exec /usr/libexec/pipewire-launcher
exec mako
exec ibus-daemon -drx
exec swayidle -w \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep '$lock'

# --- Raccourcis de base ---
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec foot
bindsym $mod+d exec $menu
bindsym $mod+b exec firefox
bindsym $mod+e exec pcmanfm
# poste de pilotage HUD : performances, fichiers, clavier
# poste de pilotage : terminal HUD plein écran avec système, réseau, fichiers, clavier
bindsym $mod+x exec plume-term --hud -a plume-pilotage
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Escape exec $lock
bindsym $mod+Shift+e exec swaynag -t warning -m 'Que faire ?' \
    -B 'Éteindre' 'sudo -n /sbin/poweroff' \
    -B 'Redémarrer' 'sudo -n /sbin/reboot' \
    -B 'Veille' 'sudo -n /usr/sbin/zzz' \
    -B 'Déconnexion' 'swaymsg exit'

# Fermer l'écran du portable = veille
bindswitch --reload --locked lid:on exec sudo -n /usr/sbin/zzz

# --- Fenêtres ---
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
# Super+Espace : saisie chinoise pinyin (activée / désactivée)
bindsym $mod+space exec ~/.config/sway/pinyin-toggle.sh
bindsym $mod+h splith
bindsym $mod+v splitv
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
floating_modifier $mod normal

mode "resize" {
    bindsym Left resize shrink width 20px
    bindsym Right resize grow width 20px
    bindsym Up resize shrink height 20px
    bindsym Down resize grow height 20px
    bindsym Escape mode "default"
    bindsym Return mode "default"
}
bindsym $mod+r mode "resize"

# --- Bureaux 1..10 (bindcode = marche en AZERTY comme en QWERTY) ---
bindcode $mod+10 workspace number 1
bindcode $mod+11 workspace number 2
bindcode $mod+12 workspace number 3
bindcode $mod+13 workspace number 4
bindcode $mod+14 workspace number 5
bindcode $mod+15 workspace number 6
bindcode $mod+16 workspace number 7
bindcode $mod+17 workspace number 8
bindcode $mod+18 workspace number 9
bindcode $mod+19 workspace number 10
bindcode $mod+Shift+10 move container to workspace number 1
bindcode $mod+Shift+11 move container to workspace number 2
bindcode $mod+Shift+12 move container to workspace number 3
bindcode $mod+Shift+13 move container to workspace number 4
bindcode $mod+Shift+14 move container to workspace number 5
bindcode $mod+Shift+15 move container to workspace number 6
bindcode $mod+Shift+16 move container to workspace number 7
bindcode $mod+Shift+17 move container to workspace number 8
bindcode $mod+Shift+18 move container to workspace number 9
bindcode $mod+Shift+19 move container to workspace number 10

# --- Touches multimédia ---
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim ~/capture-$(date +%Y%m%d-%H%M%S).png

# --- Barre + dock : plume-shell (HUD) ; swaybar + status.sh en secours ---
bar {
    swaybar_command plume-bar
    position top
    height 26
    font pango:JetBrains Mono 10
    status_command ~/.config/sway/status.sh
    colors {
        background #02060bee
        statusline #cdeefc
        separator  #1d5a78
        focused_workspace  #4fb8e0 #4fb8e0 #02060b
        active_workspace   #1d5a78 #03080e #cdeefc
        inactive_workspace #02060b #02060b #5f8ea5
        urgent_workspace   #ff5470 #ff5470 #02060b
    }
}

include /etc/sway/config.d/*
