# Socle système pour un usage quotidien (tout est petit)
sudo            # droits administrateur (« sudo commande »), comme sur Ubuntu
doas            # remplaçant minimal de sudo, gardé pour les scripts d'Alpine
dbus            # bus de messages (requis par iwd, pipewire, firefox)
seatd           # gestion des sessions graphiques, bien plus léger qu'elogind
iwd             # wifi (remplace NetworkManager + wpa_supplicant)
openresolv      # DNS pour iwd
zram-init zram-init-openrc   # swap compressé en RAM (pas de partition swap)
zzz             # mise en veille
brightnessctl   # luminosité
tzdata
